# ---------------------------------------------------------------------------
# LinkedIn OAuth credentials
# ---------------------------------------------------------------------------
# 1. Go to https://www.linkedin.com/developers/apps and create an app.
# 2. Under "Products", add "Sign In with LinkedIn using OpenID Connect".
# 3. Under "Auth", add the redirect URL below to "Authorized redirect URLs".
# 4. Copy the Client ID and Client Secret here.
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match one of the Authorized redirect URLs in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Scopes requested from LinkedIn (space separated).
# "openid profile email" is what a standard app is allowed to request.
LINKEDIN_SCOPES=openid profile email

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
PORT=3000

# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=change_me_to_a_long_random_string

# Set to "true" to run in demo mode WITHOUT real LinkedIn credentials.
# The "Connect LinkedIn" button will load a sample profile so you can try
# the resume/CV generation end-to-end.
DEMO_MODE=true
